# root'd configuration: one file for the backend and frontend.
# Copy to .env (in this same repo-root folder) and fill in. .env is git-ignored; never commit it.
#
# Safety: only variables starting with VITE_ are sent to the browser. Everything else (API keys)
# stays on the server. Never give a secret a VITE_ prefix.
# Restart both servers after editing.

# ============================ OpenRouter ============================
# Server-side only. Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# A vision-capable model your team has verified on OpenRouter
# (browse https://openrouter.ai/models?input_modalities=image). Not hardcoded on purpose.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME="root'd"

# ============================== Optional =============================
# Leave blank in development: Vite proxies /api to http://localhost:8000.
# Set to the API origin (e.g. https://api.example.com) for a deployed frontend.
VITE_API_BASE_URL=
# openFDA works without a key (lower rate limit). https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Defaults to backend/rootd.sqlite3
DATABASE_PATH=
# Comma-separated browser origins allowed to call the API directly (not needed with the Vite proxy)
CORS_ORIGINS=http://localhost:5173
# Max photo upload size in bytes (default 8 MB)
MAX_UPLOAD_BYTES=8388608
